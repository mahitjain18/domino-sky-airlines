# DOMINO SKY — AI AIRLINE OPERATIONS CONTROL CENTRE
# ENVIRONMENT CONFIGURATION TEMPLATE
# Sensitive configuration must be stored in secure environment variables.
# Never commit real API keys or credentials to version control.

# Application Information
VITE_APP_TITLE=DOMINO SKY — AI Airline Operations Control Centre
VITE_APP_ENV=production
VITE_APP_TIMEZONE=Asia/Kolkata

# Aviation Regulatory Baseline Parameters (Civil Aviation DGCA)
VITE_DGCA_MIN_TURNAROUND_MINS=30
VITE_DGCA_MAX_CREW_DUTY_MINS=600
VITE_MAX_DISRUPTION_SIMULATION_MINS=360

# Telemetry Logging & Reporting
VITE_ENABLE_ANALYTICS=false
VITE_TELEMETRY_LOG_LEVEL=info
